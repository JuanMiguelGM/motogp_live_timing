<nav class="h-14 bg-gray-900 border-b border-gray-800 flex items-center px-4 justify-between">
  <div class="flex items-center gap-4">
    <%= link_to root_path, class: "text-red-500 font-bold text-lg tracking-wider hover:text-red-400" do %>
      MotoGP LIVE TIMING
    <% end %>
    <%= link_to "Calendar", events_path, class: "text-gray-400 hover:text-gray-200 text-sm" %>
    <% Season.order(year: :desc).each do |season| %>
      <%= link_to season.year, events_path(year: season.year),
          class: "text-gray-500 hover:text-gray-200 text-xs" %>
    <% end %>
  </div>

  <% if @session %>
    <div class="flex items-center gap-3 text-sm">
      <%= render "shared/weather_strip", weather: @weather %>
      <span class="text-gray-500">|</span>
      <span class="text-gray-400"><%= @session.event&.name %></span>
      <span class="text-gray-500">|</span>
      <span class="text-gray-300"><%= @session.session_type %></span>
      <span class="text-gray-500">|</span>
      <%= render "shared/session_status_badge", session: @session %>
      <% if @session.status == 'live' %>
        <span data-live-indicator class="hidden text-green-400 text-xs flex items-center gap-1">
          <span class="inline-block w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          CONNECTED
        </span>
      <% end %>
    </div>
  <% end %>
</nav>
